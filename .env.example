# GEMINI_API_KEY: Optional Gemini API Key
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NUGEN_API_KEY: Optional API key for Nugen Intelligence (https://docs.nugen.in/)
# When omitted, HeatShield AI automatically operates in clear Demo Safety Assistant mode.
NUGEN_API_KEY=""

# NUGEN_BASE_URL: Base URL for Nugen Intelligence API (https://api.nugen.in)
NUGEN_BASE_URL="https://api.nugen.in"

# NUGEN_MODEL: Optional base model or aligned model ID (defaults to Qwen/Qwen2.5-7B-Instruct)
NUGEN_MODEL="Qwen/Qwen2.5-7B-Instruct"

# PORT: Server port (defaults to 3000)
PORT=3000
